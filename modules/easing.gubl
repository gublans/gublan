// easing: smooth ways to go from 0 to 1. give each function a number from 0 (start) to 1 (finish).
// use easing
// x = start + (finish - start) * easeout(t)

function easein t
    return t * t
end

function easeout t
    return 1 - (1 - t) * (1 - t)
end

function easeinout t
    if t < 0.5
        return 2 * t * t
    end
    return 1 - ((-2 * t + 2) ** 2) / 2
end

function bounce t
    if t < 1 / 2.75
        return 7.5625 * t * t
    elseif t < 2 / 2.75
        t2 = t - 1.5 / 2.75
        return 7.5625 * t2 * t2 + 0.75
    elseif t < 2.5 / 2.75
        t2 = t - 2.25 / 2.75
        return 7.5625 * t2 * t2 + 0.9375
    end
    t2 = t - 2.625 / 2.75
    return 7.5625 * t2 * t2 + 0.984375
end

function elastic t
    if t <= 0 or t >= 1
        return t
    end
    return 2 ** (-10 * t) * sin((t * 10 - 0.75) * (2 * pi / 3)) + 1
end
