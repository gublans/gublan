// garden 3d: a little scene of trees and a pond. left and right walk round it, up and down go nearer
mode 3d
background #9cc7e6
light 1 2 1 1.1

plane grass 0 -1 -8 24 24 moss
plane pond 3 -0.98 -6 4 3 #4f8fb8
block path 0 -0.95 -4 1.4 0.1 9 sand
cylinder trunk -3 0 -9 0.3 2 brown
cone leaves -3 1.8 -9 1.3 2.4 forest
cylinder trunk2 4 -0.25 -11 0.25 1.5 brown
cone leaves2 4 1.2 -11 1 2 forest
block house -1 0 -12 3 2 2.5 #d9b48f
cone roof -1 1.9 -12 2.3 1.6 #b5523b
sphere sun 7 5 -22 1.2 yellow
text hud 16 16 left and right walk round the garden. up and down go nearer.

angle = 0
far = 11
forever
    if keydown("left")
        angle -= 60 * dt
    end
    if keydown("right")
        angle += 60 * dt
    end
    if keydown("up")
        far = max(5, far - 6 * dt)
    end
    if keydown("down")
        far = min(20, far + 6 * dt)
    end
    camera {sin(angle) * far} 2.5 {-8 + cos(angle) * far}
    lookat 0 0 -8
    frame
end
